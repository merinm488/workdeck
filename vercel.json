{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/docs/:id([a-z0-9_]{14,})",
      "destination": "/docs/index.html?doc=:id"
    },
    {
      "source": "/sheets/:id([a-z0-9_]{14,})",
      "destination": "/sheets/editor.html?id=:id"
    },
    {
      "source": "/forms/:id([a-z0-9_]{14,})",
      "destination": "/forms/editor.html?id=:id"
    },
    {
      "source": "/slides/:id([a-z0-9_]{14,})",
      "destination": "/slides/editor.html?id=:id"
    },
    {
      "source": "/draw/:id([a-z0-9_]{14,})",
      "destination": "/draw/editor.html?id=:id"
    },
    {
      "source": "/todo/:id([a-z0-9_]{14,})",
      "destination": "/todo/index.html?list=:id"
    },
    {
      "source": "/calendar/:id([a-z0-9_]{14,})",
      "destination": "/calendar/index.html?cal=:id"
    },
    {
      "source": "/kanban/:id([a-z0-9_]{14,})",
      "destination": "/kanban/index.html?board=:id"
    },
    {
      "source": "/files/:id([a-z0-9_]{14,})",
      "destination": "/files/index.html?id=:id"
    },
    {
      "source": "/f/:id([a-z0-9_]{14,})",
      "destination": "/f.html?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/llm.txt",
      "destination": "/llms.txt",
      "permanent": true
    },
    {
      "source": "/filebox/:path*",
      "destination": "/files/:path*"
    },
    {
      "source": "/sheets/home.html",
      "destination": "/sheets/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
