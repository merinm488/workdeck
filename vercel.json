{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/docs/:id([a-z0-9]{14,})",
      "destination": "/docs/index.html?doc=:id"
    },
    {
      "source": "/sheets/:id([a-z0-9]{14,})",
      "destination": "/sheets/editor.html?id=:id"
    },
    {
      "source": "/forms/:id([a-z0-9]{14,})",
      "destination": "/forms/editor.html?id=:id"
    },
    {
      "source": "/slides/:id([a-z0-9]{14,})",
      "destination": "/slides/editor.html?id=:id"
    },
    {
      "source": "/draw/:id([a-z0-9]{14,})",
      "destination": "/draw/editor.html?id=:id"
    },
    {
      "source": "/filebox/:id([a-z0-9]{14,})",
      "destination": "/filebox/index.html?id=:id"
    },
    {
      "source": "/f/:id([a-z0-9]{14,})",
      "destination": "/f.html?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
