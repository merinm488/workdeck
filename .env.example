# ================================================
# Workdeck - Environment Configuration Example
# ================================================
# Copy this file to .env for local development.
# For Vercel deployment, set these in:
#   Project Settings -> Environment Variables

# Pepper used for key hashing. Must be the SAME value across
# Docs, Sheets and Workdeck so one key = one account everywhere.
# Generate a strong value for production with: openssl rand -base64 32
PEPPER_SECRET=dev-pepper-change-in-production-9F2a-5xK8

# NODE_ENV is set to "production" by Vercel automatically.
# Locally it should stay "development" so the API uses local
# db/users/*.json files instead of textdb.dev.
NODE_ENV=development

# Workdeck account key for AI agents — the same key the user signs in
# with. Agents read it from the .env where THEY run (not on the server);
# the server resolves it to the account. Treat it like a password.
# WORKDECK_KEY= your-workdeck-key

# Remote MCP (Todo only). The same 64 hex characters must remain configured
# across deployments or existing MCP connections will stop working.
# Generate with: openssl rand -hex 32
# MCP_AUTH_SECRET=
# HTTPS origin of this deployment, without a trailing slash. Set separately
# for each production / preview deployment that should accept MCP connections.
# MCP_PUBLIC_ORIGIN=https://workdeck-m.vercel.app
